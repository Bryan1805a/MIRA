<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <!-- Chat content: the root destination of the app -->
        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/chatToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize">

                <LinearLayout
                    android:id="@+id/toolbarTitleLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginEnd="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/toolbarTitleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/app_name"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/effortButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="8dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="0dp"
                        android:text="@string/effort_option_medium"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:backgroundTint="?attr/colorSurfaceContainerHigh"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_tune"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="14dp"
                        app:iconTint="?attr/colorOnSurfaceVariant"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/newChatTopButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/new_chat"
                    app:icon="@drawable/ic_add"
                    app:iconSize="22dp"
                    app:iconTint="?attr/colorOnSurface" />
            </com.google.android.material.appbar.MaterialToolbar>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/messageList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <!-- Brand glow behind the empty state -->
                <View
                    android:id="@+id/glowView"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_glow"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_spark" />

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="@string/greeting_default"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/greetingSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/greeting_subtitle"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Horizontal prompt suggestion cards -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/suggestionExplain"
                                android:layout_width="160dp"
                                android:layout_height="116dp"
                                android:layout_marginEnd="10dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorOutlineVariant"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_lightbulb"
                                        app:tint="?attr/colorPrimary" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:ellipsize="end"
                                        android:maxLines="3"
                                        android:text="@string/suggestion_explain_label"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/suggestionSummarize"
                                android:layout_width="160dp"
                                android:layout_height="116dp"
                                android:layout_marginEnd="10dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorOutlineVariant"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_list"
                                        app:tint="?attr/colorPrimary" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:ellipsize="end"
                                        android:maxLines="3"
                                        android:text="@string/suggestion_summarize_label"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/suggestionDebug"
                                android:layout_width="160dp"
                                android:layout_height="116dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorOutlineVariant"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_code"
                                        app:tint="?attr/colorPrimary" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:ellipsize="end"
                                        android:maxLines="3"
                                        android:text="@string/suggestion_debug_label"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="@string/loading"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="32dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="4dp"
                android:paddingEnd="20dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/memoryChip"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/memory_chip_action"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingTop="0dp"
                android:paddingEnd="10dp"
                android:paddingBottom="0dp"
                android:text="@string/memory_chip_on"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                app:backgroundTint="?attr/colorSurfaceContainerHigh"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_memory"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="14dp"
                app:iconTint="?attr/colorPrimary"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp" />

            <!-- Floating prompt capsule -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_prompt_bar"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/messageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/message_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="4000"
                    android:maxLines="5"
                    android:minLines="1"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="12dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendButton"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:contentDescription="@string/send"
                    app:backgroundTint="?attr/colorPrimary"
                    app:icon="@drawable/ic_send"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="?attr/colorOnPrimary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Navigation drawer -->
        <LinearLayout
            android:id="@+id/drawerPanel"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?attr/colorSurface"
            android:elevation="3dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawerClose"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/close_navigation"
                    app:icon="@drawable/ic_close"
                    app:iconPadding="0dp"
                    app:iconSize="20dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/newChatButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:text="@string/new_chat"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="?attr/colorOnPrimaryContainer" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/drawerSearchLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:hint="@string/search_chats"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusTopStart="20dp"
                app:endIconMode="clear_text"
                app:endIconTint="?attr/colorOnSurfaceVariant"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="?attr/colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/drawerSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/recent_chats"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/drawerConversations"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/drawerEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:paddingStart="24dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="24dp"
                    android:text="@string/drawer_no_chats"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- Account footer: identity plus the settings entry point -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:id="@+id/drawerEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawerSettings"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/settings"
                    app:icon="@drawable/ic_settings"
                    app:iconPadding="0dp"
                    app:iconSize="20dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.drawerlayout.widget.DrawerLayout>
</FrameLayout>
