<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        MIRA dark palette: deep charcoal canvas rather than a tinted black, so
        long AI answers read like a document instead of a chat log.
    -->

    <!-- Neutral canvas -->
    <color name="brand_bg">#131314</color>
    <color name="brand_surface">#131314</color>
    <color name="brand_soft_surface">#1E1F20</color>
    <color name="brand_soft_surface_high">#2A2B2D</color>
    <color name="brand_surface_variant">#1E1F20</color>
    <color name="brand_ink">#E3E3E3</color>
    <color name="brand_ink_muted">#C4C7C5</color>

    <!-- Primary: MIRA purple (dark tone) -->
    <color name="brand_primary">#C7B5FF</color>
    <color name="brand_on_primary">#2A0B66</color>
    <color name="brand_primary_container">#4A2F9E</color>
    <color name="brand_on_primary_container">#E7DEFF</color>

    <!-- Secondary: lighter violet for selected states and tonal surfaces -->
    <color name="brand_secondary">#CBB2EE</color>
    <color name="brand_on_secondary">#3A1D63</color>
    <color name="brand_secondary_container">#4E2F7D</color>
    <color name="brand_on_secondary_container">#EDDBFF</color>

    <!-- Tertiary: gradient coral (dark tone) -->
    <color name="brand_tertiary">#FFB3BE</color>
    <color name="brand_on_tertiary">#5E1130</color>
    <color name="brand_tertiary_container">#7D2946</color>
    <color name="brand_on_tertiary_container">#FFD9DF</color>

    <!-- Outlines and error -->
    <color name="brand_outline">#8E918F</color>
    <color name="brand_outline_variant">#444746</color>
    <color name="brand_error">#FFB4AB</color>
    <color name="brand_on_error">#690005</color>
    <color name="brand_error_container">#93000A</color>
    <color name="brand_on_error_container">#FFDAD6</color>

    <!-- Launch surface used by the Android 12+ splash screen -->
    <color name="brand_splash">#131314</color>

    <!-- Signature gradient stops (same hues, slightly lifted for dark mode) -->
    <color name="brand_gradient_start">#4285F4</color>
    <color name="brand_gradient_mid">#9B72CB</color>
    <color name="brand_gradient_end">#D96570</color>

    <!-- Soft purple glow behind the empty chat state -->
    <color name="brand_glow">#66B9A5FF</color>

    <!-- Account avatar plate in the drawer footer -->
    <color name="brand_avatar_bg">#4A2F9E</color>
</resources>
