<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        MIRA light palette: neutral, low-contrast surfaces for reading comfort,
        with the three gradient hues reserved for brand and active moments.
    -->

    <!-- Neutral canvas -->
    <color name="brand_bg">#FFFFFF</color>
    <color name="brand_surface">#FFFFFF</color>
    <color name="brand_soft_surface">#F8FAFD</color>
    <color name="brand_soft_surface_high">#F0F4F9</color>
    <color name="brand_surface_variant">#F0F4F9</color>
    <color name="brand_ink">#1F1F1F</color>
    <color name="brand_ink_muted">#444746</color>

    <!-- Primary: Gemini blue -->
    <color name="brand_primary">#3F6CF4</color>
    <color name="brand_on_primary">#FFFFFF</color>
    <color name="brand_primary_container">#D9E2FF</color>
    <color name="brand_on_primary_container">#00164E</color>

    <!-- Secondary: gradient violet -->
    <color name="brand_secondary">#8455C8</color>
    <color name="brand_on_secondary">#FFFFFF</color>
    <color name="brand_secondary_container">#EEDBFF</color>
    <color name="brand_on_secondary_container">#2B0B52</color>

    <!-- Tertiary: gradient coral -->
    <color name="brand_tertiary">#B5385A</color>
    <color name="brand_on_tertiary">#FFFFFF</color>
    <color name="brand_tertiary_container">#FFD9DF</color>
    <color name="brand_on_tertiary_container">#3F0018</color>

    <!-- Outlines and error -->
    <color name="brand_outline">#C4C7C5</color>
    <color name="brand_outline_variant">#E1E3E1</color>
    <color name="brand_error">#BA1A1A</color>
    <color name="brand_on_error">#FFFFFF</color>
    <color name="brand_error_container">#FFDAD6</color>
    <color name="brand_on_error_container">#410002</color>

    <!-- Launch surface used by the Android 12+ splash screen -->
    <color name="brand_splash">#FFFFFF</color>

    <!-- Signature gradient stops shared by the icon, hero, and spark mark -->
    <color name="brand_gradient_start">#4285F4</color>
    <color name="brand_gradient_mid">#9B72CB</color>
    <color name="brand_gradient_end">#D96570</color>
</resources>
